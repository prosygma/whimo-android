# Copy this file to config/secrets.properties. Values do not need quotes.
# A plain KEY applies to every build; DEBUG_<KEY> / RELEASE_<KEY> override it
# for one build type. The release workflow checks MAPBOX_PUBLIC_TOKEN=pk.*.

# Mapbox PUBLIC token (pk.*), read by the Maps SDK at startup.
MAPBOX_PUBLIC_TOKEN=pk.REPLACE_WITH_MAPBOX_PUBLIC_TOKEN

# The WEB application OAuth client ID (not an Android one).
GOOGLE_AUTH_CLIENT_ID=REPLACE_WITH_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Optional legacy fields: the current captcha page owns the Turnstile sitekey.
# Android uses CAPTCHA_URL from config/build.properties instead.
# DEBUG_CAPTCHA_SITE_KEY=REPLACE_WITH_DEV_SITE_KEY
# RELEASE_CAPTCHA_SITE_KEY=REPLACE_WITH_PROD_SITE_KEY
